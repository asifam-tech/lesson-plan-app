# Server
PORT=5000
NODE_ENV=production

# MySQL database - OPTION A: separate values
DB_HOST=your-remote-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-existing-database-name
DB_SSL=false

# OPTION B: use a MySQL connection string instead of DB_HOST/DB_USER/etc.
# DATABASE_URL=mysql://user:password@host:3306/database
# MYSQL_URL=mysql://user:password@host:3306/database
# NOTE: PostgreSQL/Supabase postgresql:// URLs are NOT compatible with this backend.

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS
CLIENT_URL=https://lesson-plan-app-two.vercel.app
